# PostgreSQL
DATABASE_URL=postgresql+asyncpg://lifestack:lifestack@localhost:5432/lifestack

# Redis
REDIS_URL=redis://localhost:6379/1

# App environment: local, test, staging, or production.
# ENV=production fails fast unless secure cookies, non-default secrets, metrics token,
# enabled rate limiting, and non-memory rate-limit storage are configured.
ENV=local

# Auth
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_SECONDS=1800
REFRESH_TOKEN_EXPIRE_SECONDS=604800
COOKIE_SECURE=false

# Rate Limiting
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_AUTH=10/minute
# Set to REDIS_URL value for production; defaults to memory:// for local dev
# RATE_LIMIT_STORAGE_URI=redis://localhost:6379/1

# App
# CORS origins are normalized to scheme + host[:port]; paths/trailing slashes are dropped automatically.
LOG_LEVEL=INFO
BACKEND_CORS_ORIGINS=["http://localhost:5173"]
# When True, CSV/Excel imports are processed inline (200 response) instead of
# via BackgroundTasks (202 + poll). Useful when you prefer simpler deployments
# without client-side polling. Defaults to False (async background processing).
# RUN_BACKGROUND_TASKS_SYNCHRONOUSLY=True
# Optional override for cookie-authenticated mutating requests; falls back to BACKEND_CORS_ORIGINS.
# CSRF_TRUSTED_ORIGINS=["http://localhost:5173"]

# Observability
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Bulk Imports (Spec 020)
# none|local|s3
IMPORT_STORAGE_BACKEND=none
IMPORT_LOCAL_PATH=/var/lib/lifestack/imports

# S3-compatible object storage (AWS S3, MinIO, Cloudflare R2, etc)
# IMPORT_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# IMPORT_S3_BUCKET=lifestack-imports
# IMPORT_S3_REGION=auto
# IMPORT_S3_ACCESS_KEY=...
# IMPORT_S3_SECRET_KEY=...
# IMPORT_S3_FORCE_PATH_STYLE=false

# Cloudflare R2 aliases (optional; map to IMPORT_S3_* automatically)
# CLOUDFLARE_R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# CLOUDFLARE_R2_BUCKET=lifestack-imports
# CLOUDFLARE_R2_REGION=auto
# CLOUDFLARE_R2_ACCESS_KEY=...
# CLOUDFLARE_R2_SECRET_KEY=...

# AI Voice Agent (Spec 021)
# GEMINI_API_KEY=your-gemini-api-key-here
# Gemini live WebSocket endpoint and model
# GEMINI_LIVE_URL=wss://generativelanguage.googleapis.com/ws/google.ai.generativelanguage.v1beta.GenerativeService.BidiGenerateContent
# GEMINI_MODEL=models/gemini-2.5-flash-native-audio-latest
# CAPTURE_MAX_WS_FRAME_BYTES=262144
# CAPTURE_MAX_SESSION_BYTES=15728640
# CAPTURE_MAX_SESSION_SECONDS=300
# CAPTURE_MAX_TEXT_CHARS=4000
EXCHANGERATE_API_KEY=your-exchangerate-free-api-key

# Local E2E harness only. Must stay false outside local/test.
ENABLE_E2E_TEST_HOOKS=false

# Export Storage Hardening (Spec 006)
# db|local|s3
EXPORT_STORAGE_BACKEND=db
EXPORT_LOCAL_PATH=/var/lib/lifestack/exports
EXPORT_TTL_DAYS=365
EXPORT_CLEANUP_ENABLED=true
EXPORT_CLEANUP_DELETE_FILES=true
EXPORT_CLEANUP_DELETE_RECORDS=false
# Optional overrides for export storage; defaults fallback to IMPORT_S3_* values
# EXPORT_S3_ENDPOINT=
# EXPORT_S3_BUCKET=
# EXPORT_S3_REGION=
# EXPORT_S3_ACCESS_KEY=
# EXPORT_S3_SECRET_KEY=
# EXPORT_S3_FORCE_PATH_STYLE=

# Daily PostgreSQL backups to an S3-compatible bucket (Cloudflare R2 or OCI Object Storage).
# DB_BACKUP_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# DB_BACKUP_S3_BUCKET=lifestack-backups
# DB_BACKUP_S3_REGION=auto
# DB_BACKUP_S3_ACCESS_KEY=...
# DB_BACKUP_S3_SECRET_KEY=...
# Required by default for client-side AES-256 encryption:
# DB_BACKUP_ENCRYPTION_KEY=use-a-long-random-secret
# DB_BACKUP_ALLOW_UNENCRYPTED=false
# DB_BACKUP_PREFIX=database-backups
# DB_BACKUP_RETENTION_DAYS=30
# DB_BACKUP_HOUR_UTC=3
# DB_BACKUP_RUN_ON_START=false

# Cloudflare Tunnel
# CLOUDFLARE_TUNNEL_TOKEN=your-cloudflare-tunnel-token-here
