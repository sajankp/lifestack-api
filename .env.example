# PostgreSQL
DATABASE_URL=postgresql+asyncpg://lifestack:lifestack@localhost:5432/lifestack

# Redis
REDIS_URL=redis://localhost:6379/1

# App environment: local, test, staging, or production.
# ENV=production fails fast unless secure cookies, non-default secrets, metrics token,
# enabled rate limiting, and non-memory rate-limit storage are configured.
ENV=local

# Auth
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_SECONDS=1800
REFRESH_TOKEN_EXPIRE_SECONDS=604800
COOKIE_SECURE=false

# Rate Limiting
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_AUTH=10/minute
# Set to REDIS_URL value for production; defaults to memory:// for local dev
# RATE_LIMIT_STORAGE_URI=redis://localhost:6379/1

# Response Cache (spec-087) — TTL-only cache-aside for /dashboard/summary and /finance/net-worth.
# Off by default everywhere; flip on in staging/production once Redis is confirmed reachable.
# ENABLE_RESPONSE_CACHE=true
# DASHBOARD_CACHE_TTL_SECONDS=30
# NET_WORTH_CACHE_TTL_SECONDS=120

# App
# CORS origins are normalized to scheme + host[:port]; paths/trailing slashes are dropped automatically.
LOG_LEVEL=INFO
BACKEND_CORS_ORIGINS=["http://localhost:5173"]
# When True, CSV/Excel imports are processed inline (200 response) instead of
# via BackgroundTasks (202 + poll). Useful when you prefer simpler deployments
# without client-side polling. Defaults to False (async background processing).
# RUN_BACKGROUND_TASKS_SYNCHRONOUSLY=True
# Optional override for cookie-authenticated mutating requests; falls back to BACKEND_CORS_ORIGINS.
# CSRF_TRUSTED_ORIGINS=["http://localhost:5173"]

# Observability

# PostHog error tracking (spec-081). Unset POSTHOG_API_KEY ⇒ the SDK is never
# initialized (dev/test/e2e/CI default) — backend scope is exception capture only
# (unhandled API 500s + scheduled-job failures).
# POSTHOG_API_KEY=your-posthog-project-api-key
# POSTHOG_HOST=https://us.i.posthog.com

# Resend email notification channel (spec-052 channel_email, spec-081).
# EMAIL_ENABLED is the explicit master switch so a copied .env can't accidentally
# start sending; RESEND_API_KEY unset ⇒ deliveries marked skipped regardless.
# RESEND_API_KEY=your-resend-api-key
# EMAIL_FROM_ADDRESS=notifications@yourdomain.com
# EMAIL_ENABLED=false
# EMAIL_DELIVERY_BATCH_CAP=50
# EMAIL_DELIVERY_INTERVAL_MINUTES=1

# Job failure visibility & alerting (spec-088): in-run retry for the three
# external-API data-integrity jobs, a job_failures ledger, and an owner digest
# email + weekly heartbeat. OWNER_ALERT_EMAIL also identifies the owner (by
# matching User.email) for the digest's in-app notification -- unset or no
# matching user ⇒ both the email and the in-app notification are skipped;
# all fields fail safe.
# OWNER_ALERT_EMAIL=you@yourdomain.com
# JOB_FAILURE_DIGEST_ENABLED=true
# JOB_HEALTH_HEARTBEAT_ENABLED=true
# JOB_RETRY_MAX_ATTEMPTS=3
# JOB_RETRY_BASE_DELAY_SECONDS=2.0

# Daily job schedule (spec-089): deterministic IST-morning window
# (03:00-05:30 IST = 21:30-00:00 UTC), no jitter, ordered by data dependency.
# Most daily jobs run at fixed UTC times inline in app/main.py; these two
# anchors stay configurable since they're the ones a prior spec (013, 067)
# already exposed as settings.
# RECURRING_TXN_GENERATION_HOUR=22   # +minute_utc=30 inline -> 22:30 UTC = 04:00 IST
# BRIEFING_JOB_HOUR_UTC=23           # -> 23:45 UTC = 05:15 IST (+ BRIEFING_JOB_MINUTE_UTC below)
# BRIEFING_JOB_MINUTE_UTC=45

# OpenTelemetry traces/logs → PostHog OTLP (spec-082). Unset
# OTEL_EXPORTER_OTLP_ENDPOINT ⇒ no exporter installed. Implement only after the
# PostHog project above exists — OTEL_EXPORTER_OTLP_HEADERS carries auth, e.g.
# "Authorization=Bearer <posthog-project-key>".
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer your-posthog-project-key

# Bulk Imports (Spec 020)
# none|local|s3
IMPORT_STORAGE_BACKEND=none
IMPORT_LOCAL_PATH=/var/lib/lifestack/imports

# S3-compatible object storage (AWS S3, MinIO, Cloudflare R2, etc)
# IMPORT_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# IMPORT_S3_BUCKET=lifestack-imports
# IMPORT_S3_REGION=auto
# IMPORT_S3_ACCESS_KEY=...
# IMPORT_S3_SECRET_KEY=...
# IMPORT_S3_FORCE_PATH_STYLE=false

# Cloudflare R2 aliases (optional; map to IMPORT_S3_* automatically)
# CLOUDFLARE_R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# CLOUDFLARE_R2_BUCKET=lifestack-imports
# CLOUDFLARE_R2_REGION=auto
# CLOUDFLARE_R2_ACCESS_KEY=...
# CLOUDFLARE_R2_SECRET_KEY=...

# AI Voice Agent (Spec 021)
# GEMINI_API_KEY=your-gemini-api-key-here
# Gemini live WebSocket endpoint and model
# GEMINI_LIVE_URL=wss://generativelanguage.googleapis.com/ws/google.ai.generativelanguage.v1beta.GenerativeService.BidiGenerateContent
# GEMINI_MODEL=models/gemini-2.5-flash-native-audio-latest
# CAPTURE_MAX_WS_FRAME_BYTES=262144
# CAPTURE_MAX_SESSION_BYTES=15728640
# CAPTURE_MAX_SESSION_SECONDS=300
# CAPTURE_MAX_TEXT_CHARS=4000
# spec-079 Stage A: feature-off unless set. Points at a bind-mounted host path
# (see docker-compose.yml) so the voice tool-call-turn log survives container
# recreation. Rows: tool calls, plus user/assistant transcripts when the two
# transcription flags below are on.
# CAPTURE_TURN_LOG_PATH=/app/logs/capture/turns.jsonl
# spec-079 Stage B: capture the assistant's spoken reply as text (live captions +
# assistant side of the turn log above). Metered free (2026-07-13). Default false.
# CAPTURE_ENABLE_OUTPUT_TRANSCRIPTION=false
# spec-079 Q4: capture the user's own utterance as text into the turn log
# (kind=user_transcript) — the real-usage eval source. Metered free (2026-07-17).
# Default false.
# CAPTURE_ENABLE_INPUT_TRANSCRIPTION=false
# spec-079 Stage B: WebSocket transport resilience, both default false. Session
# resumption lets a reconnecting client restore Gemini conversation context after
# a dropped socket (?resume=<handle>); context compression keeps long sessions
# alive past the model's context limit. Enable only after confirming the
# deployed GEMINI_MODEL accepts these Gemini Live setup fields.
# CAPTURE_ENABLE_SESSION_RESUMPTION=false
# CAPTURE_ENABLE_CONTEXT_COMPRESSION=false
EXCHANGERATE_API_KEY=your-exchangerate-free-api-key

# Local E2E harness only. Must stay false outside local/test.
ENABLE_E2E_TEST_HOOKS=false

# Security reference data (Spec 083). Bundled data works fully offline by
# default; the Yahoo quote/identity API fallback is opt-in.
REFERENCE_DATA_API_ENABLED=false
REFERENCE_DATA_CACHE_STALENESS_DAYS=30

# Export Storage Hardening (Spec 006)
# db|local|s3
EXPORT_STORAGE_BACKEND=db
EXPORT_LOCAL_PATH=/var/lib/lifestack/exports
EXPORT_TTL_DAYS=365
EXPORT_CLEANUP_ENABLED=true
EXPORT_CLEANUP_DELETE_FILES=true
EXPORT_CLEANUP_DELETE_RECORDS=false
# Optional overrides for export storage; defaults fallback to IMPORT_S3_* values
# EXPORT_S3_ENDPOINT=
# EXPORT_S3_BUCKET=
# EXPORT_S3_REGION=
# EXPORT_S3_ACCESS_KEY=
# EXPORT_S3_SECRET_KEY=
# EXPORT_S3_FORCE_PATH_STYLE=

# Daily PostgreSQL backups to an S3-compatible bucket (Cloudflare R2 or OCI Object Storage).
# DB_BACKUP_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# DB_BACKUP_S3_BUCKET=lifestack-backups
# DB_BACKUP_S3_REGION=auto
# DB_BACKUP_S3_ACCESS_KEY=...
# DB_BACKUP_S3_SECRET_KEY=...
# Required by default for client-side AES-256 encryption:
# DB_BACKUP_ENCRYPTION_KEY=use-a-long-random-secret
# DB_BACKUP_ALLOW_UNENCRYPTED=false
# DB_BACKUP_PREFIX=database-backups
# DB_BACKUP_RETENTION_DAYS=30
# DB_BACKUP_HOUR_UTC=3
# DB_BACKUP_RUN_ON_START=false

# Cloudflare Tunnel
# CLOUDFLARE_TUNNEL_TOKEN=your-cloudflare-tunnel-token-here
