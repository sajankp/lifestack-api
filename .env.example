# PostgreSQL
DATABASE_URL=postgresql+asyncpg://lifestack:lifestack@localhost:5432/lifestack

# Redis
REDIS_URL=redis://localhost:6379/1

# Auth
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_SECONDS=1800
REFRESH_TOKEN_EXPIRE_SECONDS=604800
COOKIE_SECURE=false

# Rate Limiting
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_AUTH=10/minute
# Set to REDIS_URL value for production; defaults to memory:// for local dev
# RATE_LIMIT_STORAGE_URI=redis://localhost:6379/1

# App
# CORS origins are normalized to scheme + host[:port]; paths/trailing slashes are dropped automatically.
LOG_LEVEL=INFO
BACKEND_CORS_ORIGINS=["http://localhost:5173"]
# Optional override for cookie-authenticated mutating requests; falls back to BACKEND_CORS_ORIGINS.
# CSRF_TRUSTED_ORIGINS=["http://localhost:5173"]

# Observability
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
